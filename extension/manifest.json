{
  "manifest_version": 3,
  "name": "SyncWatch",
  "version": "1.0",
  "description": "Pause, play and seek in sync with friends on any video site.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
